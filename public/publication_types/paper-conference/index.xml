&lt;script&gt;
document.addEventListener('DOMContentLoaded', function() {
var publicationFound = false;
var projectsText = 'ANID-Fondecyt Regular 1212071, ANID-PCI NSFC 190018';
function replacePublication(node) {
if (node.nodeType === 3) {
var text = node.nodeValue;
if (text.includes('Publication')) {
var newText = text.replace(/Publication/g, 'Journal');
node.nodeValue = newText;
}
if (text.trim() === 'In') { node.nodeValue = 'Journal'; }
}
}
var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
var node;
while(node = walker.nextNode()) { replacePublication(node); }
// Dynamically bold the target author's name
var authorElements = document.querySelectorAll('.article-metadata a, .article-metadata span, .author-card .card-title');
authorElements.forEach(function(el) {
if (el.textContent.includes('Mauricio Zambrano-Bigiarini')) {
el.style.fontWeight = 'bold';
}
});
// Dynamically insert Projects field immediately after the Journal field
if (projectsText !== '') {
var headings = document.querySelectorAll('.pub-row-heading');
headings.forEach(function(heading) {
if (heading.textContent.trim() === 'Journal') {
publicationFound = true;
var parentRow = heading.parentElement;
var newRow = document.createElement('div');
newRow.className = 'row';
newRow.style.paddingTop = '10px';
newRow.innerHTML = '&lt;div class="col-12 col-md-3 pub-row-heading"&gt;Projects&lt;/div&gt;&lt;div class="col-12 col-md-9"&gt;' + projectsText + '&lt;/div&gt;';
parentRow.parentNode.insertBefore(newRow, parentRow.nextSibling);
}
});
// Fallback: If 'Journal' isn't found, safely place it at the top of the manual content
if (!publicationFound) {
var manualContent = document.querySelector('.manual-content');
if (manualContent) {
var fallbackDiv = document.createElement('div');
fallbackDiv.style.marginBottom = '15px';
fallbackDiv.innerHTML = '&lt;strong&gt;Projects:&lt;/strong&gt; ' + projectsText;
manualContent.insertBefore(fallbackDiv, manualContent.firstChild);
}
}
}
});
